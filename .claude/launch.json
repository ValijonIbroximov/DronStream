{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-dev-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set DS_DEV_API=https://localhost:58443&& npm --prefix web run dev -- --port 5174 --strictPort"
      ],
      "port": 5174
    }
  ]
}
